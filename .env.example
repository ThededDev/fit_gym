# Database Configuration - Local PostgreSQL (Docker)
DATABASE_URL=postgresql://fitgym:fitgym123@127.0.0.1:5433/fitgym

# Supabase - Frontend (VITE_ prefix required for Vite to expose to client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Supabase - Backend (server-side only, never exposed to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server
PORT=8787
NODE_ENV=production
